# =================================================================
# YASHWANTH HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Yashwanth Hub works 100% out of the box in Local-First Mode (Dexie IndexedDB).
# Configure these variables only when connecting live cloud services.

# --- SUPABASE CLOUD DATABASE & AUTH ---
# Get these from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# --- GOOGLE WORKSPACE OAUTH ---
# Get this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: https://your-app.vercel.app, http://localhost:5173
# Authorized Redirect URIs: https://your-app.vercel.app, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- MULTI-MODEL AI GATEWAY KEYS (Client-side / BYOK) ---
# Can also be entered dynamically in the app's Settings -> AI Gateway
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# --- NEOSAPIEN DESKTOP & WEBHOOK INGESTION (Serverless) ---
# Optional Bearer token for authenticating incoming POST requests to /api/neosapien-webhook
NEOSAPIEN_WEBHOOK_SECRET=your-secure-webhook-secret-token
