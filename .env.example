# =================================================================
# YASHWANTH HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Hard Constraint 5: All secrets (Google refresh tokens, NeoSapien credentials,
# API keys, service roles) must remain in server-side environment variables
# or encrypted database columns, NEVER in VITE_* bundles.

# -----------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Bundled in Vite / Web / Native App)
# -----------------------------------------------------------------
# Supabase Cloud Project URL & Public Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Google OAuth Client ID (Public Web/PWA Identifier)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (Vercel Environment Variables / Cloud Runtime)
# DO NOT PREFIX WITH VITE_ — MUST NEVER BE EXPOSED TO CLIENT BUNDLES!
# -----------------------------------------------------------------
# Vercel Cron & Automation Engine Bearer Secret
# Used to authenticate scheduled runs at /api/automations/cron and /api/automations/queue
CRON_SECRET=your-secure-32-byte-cron-secret-token

# Supabase Service Role Key (Bypasses RLS for trusted background automation workers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Google OAuth Client Secret (Used on server for token refresh exchanges)
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NeoSapien Integration Secrets (Used on server for OAuth token refresh & MCP authentication)
NEOSAPIEN_CLIENT_SECRET=your-neosapien-client-secret
NEOSAPIEN_WEBHOOK_SECRET=your-secure-webhook-secret-token

# Server-Side AI API Keys (Optional fallback for server automation briefs)
GEMINI_API_KEY=your-server-gemini-api-key
OPENAI_API_KEY=your-server-openai-api-key
ANTHROPIC_API_KEY=your-server-anthropic-api-key
