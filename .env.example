# Yashwanth Hub Environment Variables (Optional for Cloud Sync)
# The application runs 100% locally with offline IndexedDB out of the box!
# When you are ready to connect Supabase:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional AI Assistant API Key (OpenAI, Gemini, Anthropic, or local Ollama)
VITE_AI_PROVIDER=offline
VITE_AI_API_KEY=
