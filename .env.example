# =================================================================
# YASHWANTH HUB / JARVIS 5.0 — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Hard Constraint: Never put real secrets inside VITE_* variables or git.

# -----------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Bundled in Vite / Web / Mobile)
# -----------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------
# 2. SERVER-SIDE VERCEL SECRETS (Encrypted Server Runtime Only)
# -----------------------------------------------------------------
CRON_SECRET=your-secure-32-byte-cron-secret-token
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
AI_VAULT_ENCRYPTION_KEY=your-32-plus-char-aes-256-gcm-secret-key

GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEOSAPIEN_CLIENT_SECRET=your-neosapien-client-secret
NEOSAPIEN_WEBHOOK_SECRET=your-secure-webhook-secret-token

# Cloud AI Provider Credentials (Configure whichever providers you use)
GEMINI_API_KEY=your-server-gemini-api-key
OPENAI_API_KEY=your-server-openai-api-key
ANTHROPIC_API_KEY=your-server-anthropic-api-key
OPENROUTER_API_KEY=your-server-openrouter-api-key
HF_TOKEN=your-huggingface-router-token
OLLAMA_BASE_URL=

# Optional Dev, Error & Notification Integrations
GITHUB_TOKEN=
VERCEL_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
N8N_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------
# 3. LOCAL JARVIS PYTHON RUNTIME (Workstation 127.0.0.1:8787)
# -----------------------------------------------------------------
JARVIS_LOCAL_HOST=127.0.0.1
JARVIS_LOCAL_PORT=8787
# Auto-generated in ~/.jarvis-local/agent.token on first launch if omitted:
JARVIS_LOCAL_TOKEN=
JARVIS_ALLOWED_DIRS=C:\Users\recvn\Desktop\yashwanth-hub
JARVIS_PRIVATE_OFFLINE_ONLY=false
JARVIS_LOCAL_CONCURRENCY=3
JARVIS_LOCAL_TASK_TIMEOUT=60
