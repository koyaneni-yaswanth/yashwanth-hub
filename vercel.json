{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/process-triggers",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/automations/cron?action=task_deadline_scan",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/automations/run",
      "destination": "/api/automations/dispatch"
    },
    {
      "source": "/api/automations/cron",
      "destination": "/api/cron/process-triggers"
    },
    {
      "source": "/api/automations/queue",
      "destination": "/api/cron/process-triggers"
    },
    {
      "source": "/api/automations",
      "destination": "/api/automations/dispatch"
    },
    {
      "source": "/api/neosapien/auth",
      "destination": "/api/neosapien/connect"
    },
    {
      "source": "/api/neosapien/disconnect",
      "destination": "/api/neosapien/connect?action=disconnect"
    },
    {
      "source": "/api/neosapien/capabilities",
      "destination": "/api/neosapien/mcp?action=tools"
    },
    {
      "source": "/api/neosapien/history",
      "destination": "/api/neosapien/mcp?action=status"
    },
    {
      "source": "/api/neosapien/status",
      "destination": "/api/neosapien/mcp?action=status"
    },
    {
      "source": "/api/neosapien/sync",
      "destination": "/api/neosapien/mcp?action=sync"
    },
    {
      "source": "/api/neosapien-webhook",
      "destination": "/api/neosapien/mcp?action=webhook"
    },
    {
      "source": "/api/neosapien/webhook",
      "destination": "/api/neosapien/mcp?action=webhook"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
